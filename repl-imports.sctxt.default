import org.legogroup.woof.Logger.given_Printer

extension [A](io: IO[A])
  def trace: IO[A] = for {
    res <- io
    _   <- IO.println(s"[${Bold.On(Color.Red(Thread.currentThread.getName)).render}] ${Underlined.On(Color.Green(res.toString)).render}")
  } yield res
